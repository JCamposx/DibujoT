<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Light theme: warm paper, dark ink, deep teal accent -->
    <style name="Theme.DibujoT" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorPrimaryVariant">@color/teal_dark</item>
        <item name="colorOnPrimary">@color/paper_warm</item>
        <item name="colorSecondary">@color/teal_light</item>
        <item name="colorOnSecondary">@color/teal_dark</item>
        <item name="colorSurface">@color/paper_warm</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/paper</item>

        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/teal_dark</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.DibujoT.NoActionBar" parent="Theme.DibujoT" />

    <!-- Toolbar: light text on primary color -->
    <style name="DibujoT.Toolbar" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="android:textColorPrimary">@color/paper_warm</item>
        <item name="android:textColorSecondary">@color/teal_light</item>
        <item name="colorControlNormal">@color/paper_warm</item>
    </style>

    <!-- Send button: full-width, rounded corners, no ripple shadow artifact -->
    <style name="DibujoT.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/teal_primary</item>
        <item name="android:textColor">@color/paper_warm</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>
