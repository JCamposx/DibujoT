<?xml version="1.0" encoding="utf-8"?>
<!-- Gallery item card: elevated, rounded, with name label underneath image -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardMaxElevation="6dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Drawing thumbnail — background matches card surface for transparent PNGs -->
        <ImageView
            android:id="@+id/iv_drawing"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:contentDescription="@string/drawing_thumbnail"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:background="?attr/colorSurface" />

        <!-- Drawing name centered at bottom of card -->
        <TextView
            android:id="@+id/tv_drawing_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
