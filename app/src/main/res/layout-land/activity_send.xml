<?xml version="1.0" encoding="utf-8"?>
<!-- Send screen — landscape: image left, controls right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Status bar background -->
    <View
        android:id="@+id/status_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/teal_dark" />

    <!-- Horizontal side-by-side layout: image | controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="48dp"
        android:paddingVertical="16dp"
        android:layout_gravity="center_horizontal">

        <!-- Left: drawing preview -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="?attr/colorSurface">

            <ImageView
                android:id="@+id/iv_drawing_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="16dp"
                android:background="?attr/colorSurface"
                android:contentDescription="@string/drawing_thumbnail" />

        </androidx.cardview.widget.CardView>

        <!-- Right: name, status, progress, button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_drawing_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:textColor="?attr/colorOnSurface"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_idle"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.55"
                android:letterSpacing="0.03"
                android:paddingBottom="16dp" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:visibility="gone"
                android:progressTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_send"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_send"
                android:textSize="15sp"
                android:letterSpacing="0.06"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
